# TerraSeek Environment Configuration
TERRASEEK_ENV=development
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL + PostGIS)
# In local development without docker, SQLite fallback is supported
DATABASE_URL=postgresql://terraseek:terraseek@localhost:5432/terraseek

# Vector Database (Qdrant)
# In local development without docker, in-memory / local storage mode is supported
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Storage & Models
STORAGE_ROOT=./data/storage
MODEL_CACHE_DIR=./data/models

# Service Ports & Networking
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ML Provider Flags (demo | local | production)
EMBEDDING_PROVIDER=demo
CHANGE_DETECTION_PROVIDER=demo
